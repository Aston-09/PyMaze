# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
backend/venv/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Game state ---
# Saves are per-player runtime data, not source. A pattern with a slash in it
# is anchored to this file's directory, so it has to name the real path —
# plain `saves/*` silently missed backend/saves/ and left the local database
# (with password hashes in it) showing up as untracked.
backend/saves/*
!backend/saves/.gitkeep

# --- Tool caches ---
.impeccable/
.claude/

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
