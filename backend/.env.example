# Copy to backend/.env and fill in. Never commit the real .env.

# Where users and saves live. Leave blank to run entirely off a local JSON
# file under backend/saves/ (single machine only — not for a deploy).
MONGODB_URI=
MONGODB_DB=pymaze

# Required. Signs every session token, so a shared or guessable value lets
# anyone mint a token for any account:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated origins the browser app is served from.
PYMAZE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
